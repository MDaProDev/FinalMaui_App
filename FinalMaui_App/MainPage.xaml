<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalMaui_App.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Button x:Name="GoToProductsBtn"
                    Text="Products"
                    Clicked="GoToProductsBtn_Clicked"/>
            <Button x:Name="GoToTasksBtn"
                    Text="Tasks"
                    Clicked="GoToTasksBtn_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
