<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FinalMaui_App.Views.Producto"
             Title="Producto"
             xmlns:model="clr-namespace:FinalMaui_App.Models"
             xmlns:viewmodels="clr-namespace:FinalMaui_App.ViewModels"
             
             x:DataType="viewmodels:ProductoViewModel">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add"/>
    </ContentPage.ToolbarItems>
    <ScrollView>
           <VerticalStackLayout>
            <Button x:Name="GoBackBtn" Text="Back" Clicked="GoBackBtn_Clicked"/>
            <Border>
            <VerticalStackLayout>
                <Entry x:Name="NameEntry" Text="{Binding Producto.Name, Mode=TwoWay}"/>
                <Entry Keyboard="Numeric" Text="{Binding Producto.Price, Mode=TwoWay}"/>
                <Entry Keyboard="Numeric" Text="{Binding Producto.Stock, Mode=TwoWay}"/>
                <HorizontalStackLayout x:DataType="viewmodels:ProductoViewModel">
                <Button Text="Add+" Command="{Binding AddProductosCommand}"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
            
        </Border>
        
        
        <ListView
            x:DataType="viewmodels:ProductoViewModel"
            VerticalScrollBarVisibility="Always"
            ItemsSource="{Binding Productos}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="model:Producto">
                    <ViewCell>
                        <Grid>
                            <Border>
                                <HorizontalStackLayout>
                                    <Border WidthRequest="800">
                                        <HorizontalStackLayout>
                                            <VerticalStackLayout>
                                                <Label Margin="10">ID:</Label>
                                                <Label Margin="10" Text="{Binding Id}"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout>
                                                <Label Margin="10">Name:</Label>
                                                <Label Margin="10" Text="{Binding Name}"/>
                                            </VerticalStackLayout>
                                            <VerticalStackLayout>
                                                <Label Margin="10">Price:</Label>
                                                <HorizontalStackLayout Margin="10">
                                                   <Label Text="{Binding Price}"/>
                                                   <Label>$</Label> 
                                                </HorizontalStackLayout>
                                                
                                            </VerticalStackLayout>
                                            <VerticalStackLayout>
                                                <Label Margin="10">Stock:</Label>
                                                <Label Margin="10" Text="{Binding Stock}"/>
                                            </VerticalStackLayout>
                                        </HorizontalStackLayout>
                                    </Border>


                                    <Button HeightRequest="30" WidthRequest="100" Text="Delete" Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProductoViewModel}}, Path=DeleteProductoCommand}" CommandParameter="{Binding .}"></Button>
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </VerticalStackLayout> 
    </ScrollView>

</ContentPage>